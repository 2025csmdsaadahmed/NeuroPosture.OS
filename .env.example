# ==============================================================================
# NEUROPOSTURE OS - DESKCORE SMART CHAIR ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT SECURITY NOTE:
# The Blynk Auth Token must ONLY be placed in backend/.env.
# It must NEVER be added to frontend code, HTML, client-side bundles, or git.
# ==============================================================================

# Backend Port
PORT=5001

# Blynk Cloud Server URL (Default: https://blynk.cloud)
BLYNK_SERVER_URL=https://blynk.cloud

# Your Device Blynk Auth Token (From Blynk Console Device Info)
# NEVER commit the real token to source control!
BLYNK_AUTH_TOKEN=MiTSlh3YYXMXx1PJIxK3jN6iGRnm5rgC

# Backend CORS Allowed Origin (Default: http://localhost:5173 for Vite dev server)
CLIENT_URL=http://localhost:5173
